{
  "name": "@duckengine/importer-gltf-v2",
  "version": "0.1.0",
  "private": false,
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b tsconfig.json",
    "test": "jest",
    "test:import": "tsx scripts/test-import.ts",
    "export:harness": "tsx scripts/export-harness.ts",
    "typecheck": "tsc --noEmit",
    "format": "npx prettier --write \"src/**/*.ts\"",
    "format:check": "npx prettier --check \"src/**/*.ts\""
  },
  "dependencies": {
    "@gltf-transform/core": "^4.0.0",
    "@gltf-transform/extensions": "^4.0.0",
    "@duckengine/core-v2": "*"
  }
}
